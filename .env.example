# ─────────────────────────────────────────────────────────────────────────────
# Operation GWG — contoh variabel lingkungan
#
# SALIN ke `.env.local`, lalu isi nilainya. JANGAN pernah mengisi nilai asli
# di berkas ini — berkas ini ikut masuk repositori.
#
#   cp .env.example .env.local
#
# Tanpa satu pun variabel di bawah, aplikasi tetap jalan dalam MODE DEMO
# (data contoh di memori, pilih persona di layar login). Cukup untuk membaca
# kode dan mengembangkan tampilan.
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase — basis data & autentikasi ──────────────────────────────────────
# Dashboard Supabase → Project Settings → API.
# Begitu ketiganya terisi, aplikasi berhenti memakai data contoh dan memakai
# basis data sungguhan.

NEXT_PUBLIC_SUPABASE_URL=https://PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci service-role: MELEWATI seluruh Row Level Security. Hanya dipakai di
# server, tidak pernah sampai ke browser. Perlakukan seperti kata sandi root
# basis data — siapa pun yang memegangnya bisa membaca dan menulis semua tabel.
SUPABASE_SERVICE_ROLE_KEY=

# Lapisan data memakai variabelnya sendiri, terpisah dari NEXT_PUBLIC_* di atas
# (lihat src/lib/data/db.ts). Isinya URL Supabase yang sama.
GWG_SUPABASE_URL=https://PROJECT-REF.supabase.co
# Cadangan kalau SUPABASE_SERVICE_ROLE_KEY tidak diisi. Umumnya dibiarkan kosong.
GWG_SUPABASE_KEY=


# ── Rahasia aplikasi ─────────────────────────────────────────────────────────
# Penanda tangan cookie sesi. WAJIB diisi di produksi (minimal 16 karakter) —
# aplikasi menolak start tanpa ini. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Mengganti nilainya akan mengeluarkan SEMUA pengguna dari sesinya.
GWG_SESSION_SECRET=

# Rahasia untuk fungsi RPC pembuatan akun (gwg_upsert_auth_user).
# Harus sama persis dengan yang tersimpan di sisi Supabase.
GWG_ADMIN_RPC_SECRET=


# ── ESB (erp.esb.co.id) — sumber data Analisis Fraud ─────────────────────────
# Dipakai menarik transaksi VOID dan CANCEL per outlet, dan omzet untuk KPI.
#
# PAKAI AKUN LAPORAN KHUSUS, BUKAN MASTER ADMIN. Akun ini hanya perlu bisa
# membuka menu Report; memberi akun master admin berarti aplikasi ini bisa
# mengubah data POS, bukan sekadar membacanya.
#
# Laporan yang dibaca: /report/report-cancel-menu-detail
ESB_BASE_URL=https://erp.esb.co.id
ESB_USERNAME=
ESB_PASSWORD=


# ── Cloudflare R2 — penyimpanan berkas & foto ────────────────────────────────
# Lampiran pengajuan, foto hygiene, bukti tindak lanjut, lampiran obrolan.
# Dashboard Cloudflare → R2 → Manage API Tokens.
R2_ENDPOINT=https://ACCOUNT-ID.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=


# ── Cron ─────────────────────────────────────────────────────────────────────
# Melindungi /api/cron/fraud-sync supaya tidak bisa dipicu sembarang orang.
# Di Vercel nilainya diisi otomatis; isi manual hanya untuk uji coba lokal.
CRON_SECRET=
